{
  "name": "ecom",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development node --watch-path=server.js server.js",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build --ssrManifest --outDir dist/client",
    "build:server": "vite build --ssr src/entry-server.jsx --outDir dist/server",
    "preview": "cross-env NODE_ENV=production node server.js",
    "serve": "cross-env NODE_ENV=production node server.js",
    "lint": "eslint ."
  },
  "dependencies": {
    "@emailjs/browser": "^5.0.3",
    "@reduxjs/toolkit": "^2.13.0",
    "compression": "^1.8.2",
    "cross-env": "^10.1.0",
    "express": "^5.3.0",
    "i18next": "^26.4.5",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.16",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.4",
    "sass": "^1.105.1",
    "sirv": "^3.0.2",
    "swiper": "^14.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "vite": "^8.3.0"
  }
}
